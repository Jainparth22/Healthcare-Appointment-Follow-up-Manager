# ============================================================================
# Healthcare Appointment & Follow-up Manager — environment configuration
# Copy to `.env` and adjust. Every value has a safe default; the app runs with
# ZERO external infra out of the box (SQLite + Celery eager + console email +
# LLM fallback + no-op cache/calendar). Nothing here is required to start.
# ============================================================================

# ---- Application ----
APP_NAME="Healthcare Appointment & Follow-up Manager"
ENV=development
DEBUG=true
LOG_LEVEL=INFO
# CHANGE THIS in production (used for JWT signing + Fernet key derivation).
SECRET_KEY=dev-secret-change-me-in-production
BASE_URL=http://localhost:8000
CLINIC_TZ=Asia/Kolkata

# ---- Database ----
# SQLite (default, zero infra). For Postgres deploy, use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/hcv
DATABASE_URL=sqlite:///./hcv.db

# ---- Auth / JWT ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# ---- Redis (used for cache, locks, idempotency, rate limiting, Celery) ----
# If Redis is down/absent the app degrades gracefully (cache no-op, lock falls
# back to the DB unique index, rate-limit fails open).
REDIS_URL=redis://localhost:6379/0

# ---- Celery ----
# Leave broker/backend empty to reuse REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# true = run tasks inline (no worker needed). Set false + run a worker/beat for
# the real async topology (see docker-compose.yml).
CELERY_TASK_ALWAYS_EAGER=true

# ---- Booking / slots ----
HOLD_MINUTES=10
SLOT_WINDOW_DAYS=60
LOCK_TTL_MS=5000

# ---- LLM (Gemini default; Anthropic optional) ----
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=20
# Get a free key at https://aistudio.google.com/app/apikey . Leave empty to use
# the deterministic keyword-heuristic fallback (app never breaks).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional alternative provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Email ----
# console = print to stdout (default). Other backends: smtp | sendgrid
EMAIL_BACKEND=console
EMAIL_FROM=clinic@example.com
EMAIL_FROM_NAME="City Clinic"
EMAIL_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDGRID_API_KEY=

# ---- Google Calendar (optional; unconfigured = logged no-op) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
# 32-byte urlsafe base64 Fernet key. Leave empty to derive from SECRET_KEY.
FERNET_KEY=

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true

# ---- Seed / demo accounts ----
SEED_ADMIN_EMAIL=admin@clinic.test
SEED_ADMIN_PASSWORD=admin12345
